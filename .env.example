# Aplicacion
NODE_ENV=development
PORT=3000
IDENTIDAD_NAME=identidad

# BD Identidad (PostgreSQL). DB_PORT=5433 es el puerto publicado por
# docker-compose.local.yml hacia el host; dentro de la red de compose es 5432.
DB_HOST=localhost
DB_PORT=5433
DB_USER=identidad
DB_PASSWORD=identidad
DB_NAME=identidad

# Muestra las consultas SQL en consola.
DB_LOGGING=false

# Microservicio terceros (verificacion KYC). Nunca una IP ni un host en codigo.
TERCEROS_URL=http://localhost:3007
