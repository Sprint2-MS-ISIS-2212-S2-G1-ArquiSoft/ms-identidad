# Aplicacion
NODE_ENV=development
PORT=3000
IDENTIDAD_NAME=identidad

# Modo de ejecucion (Tactica 1: Aislamiento de CPU/hilos entre API Online y Worker Batch)
# Valores: api | worker | both
MODE=api

# BD Identidad (PostgreSQL) - Tactica 2: Read/Write Splitting (Primary + Read Replica)
DB_HOST=localhost
DB_PRIMARY_HOST=localhost
DB_REPLICA_HOST=localhost
DB_PORT=5433
DB_USER=identidad
DB_PASSWORD=identidad
DB_NAME=identidad
DB_SSL=false

# Tactica 3: Limite de Conexiones (Connection Pool Throttling - Regla del 70%)
# Si RDS soporta M conexiones (RDS_MAX_CONNECTIONS), los workers usan maximo el 70%
# dividido entre MAX_WORKER_REPLICAS, reservando el 30% para Identidad API.
RDS_MAX_CONNECTIONS=100
MAX_WORKER_REPLICAS=4
DB_POOL_SIZE=15

# Tactica 4: Desacoplamiento asincrono y Competing Consumers con Amazon SQS
AWS_REGION=us-east-1
SQS_QUEUE_URL=
SQS_CONCURRENCY=6
WORKER_WRITE_BACK=true

# Muestra las consultas SQL en consola.
DB_LOGGING=false

# Microservicio terceros (verificacion KYC). Nunca una IP ni un host en codigo.
TERCEROS_URL=http://localhost:3007
